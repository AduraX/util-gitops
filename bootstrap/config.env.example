# util-gitops bootstrap configuration
# Copy to config.env and fill in values before running bootstrap.sh

# Domain for ArgoCD HTTPRoutes (K8s services)
DOMAIN=gitops.lcl

# Gitea (running in Docker via utilStack)
GITEA_DOMAIN=gitea.util.lcl
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=changeme

# Keycloak (running in Docker via utilStack)
KEYCLOAK_DOMAIN=keycloak.util.lcl
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# ArgoCD
ARGOCD_VERSION=10.9.1

# Grafana (if monitoring group enabled)
GRAFANA_ADMIN_PASSWORD=changeme

# Forge4X deploy repo (optional)
# F4X_DEPLOY_REPO_URL=https://gitea.util.lcl/${GITEA_ADMIN_USER}/f4x-dev-01-gitops.git
