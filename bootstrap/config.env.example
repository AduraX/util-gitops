# util-gitops bootstrap configuration
# Copy to config.env and fill in values before running bootstrap.sh

# Cluster type: kind | rke2
CLUSTER_TYPE=kind

# Domain configuration
DOMAIN=gitops.lcl

# Gitea admin credentials
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=changeme
GITEA_ADMIN_EMAIL=admin@gitops.lcl

# ArgoCD
ARGOCD_VERSION=3.3.3

# CNPG database passwords
GITEA_DB_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme

# Keycloak admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# MetalLB IP range (auto-detected for Kind, manual for RKE2)
# METALLB_RANGE_START=192.168.1.200
# METALLB_RANGE_END=192.168.1.250

# Forge4X deploy repo (optional)
# F4X_DEPLOY_REPO_URL=https://gitea.gitops.lcl/admin/f4x-dev-01-gitops.git
